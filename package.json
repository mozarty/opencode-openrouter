{
  "name": "opencode-openrouter",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin: OpenRouter spend, budget and daily average in the sidebar",
  "type": "module",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "openrouter",
    "usage",
    "budget",
    "cost",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Ahmed Salem",
  "homepage": "https://github.com/mozarty/opencode-openrouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozarty/opencode-openrouter.git"
  },
  "bugs": {
    "url": "https://github.com/mozarty/opencode-openrouter/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "smoke:bun": "bun script/smoke.bun.ts",
    "prepublishOnly": "npm run typecheck && npm run check && npm test"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.4.1",
    "@opentui/core": ">=0.9.4",
    "@opentui/solid": ">=0.9.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opencode/plugin": "2.4.1",
    "@opencode/theme": "2.4.1",
    "@opentui/core": "0.9.4",
    "@opentui/solid": "0.9.4",
    "@types/node": "24.12.2",
    "solid-js": "1.9.17"
  }
}
